# Server
PORT=3000

# Postgres — usate sia da docker-compose.yml (per creare il container)
# sia per comporre DATABASE_URL qui sotto. Tienile allineate.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cinema
POSTGRES_PORT=5432

# Connection string effettiva usata dall'app (Drizzle). Deve riflettere i valori sopra.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cinema

# Redis — usata sia da docker-compose.yml sia per comporre REDIS_URL
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Adminer (GUI Postgres, solo sviluppo)
ADMINER_PORT=8080

# Auth
# Obbligatorio: nessun default in produzione. In sviluppo puoi usare una stringa qualsiasi,
# ma non committare mai il valore reale usato in staging/produzione.
JWT_SECRET=secrettokenjwt
JWT_EXPIRES_IN=1h

# Business rules (Multiplex Aurora — vedi project-context.md)
CACHE_TTL_SECONDS=300
SALA_CLEANUP_BUFFER_MINUTES=15
CANCELLATION_DEADLINE_HOURS=3
